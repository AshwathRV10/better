# Environment for the automated test suites.
#
# Integration tests TRUNCATE every table, so they must never point at a database
# that holds anything you care about. This file keeps them isolated from the
# development database the app and the end-to-end suite use.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/betterdb_test?schema=public"
DATA_PROVIDER="demo"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_ACCESS_KEY=""
RATE_LIMIT_MAX="120"
RATE_LIMIT_WINDOW_MS="60000"
