# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/betterdb?schema=public"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Which data provider the ingestion layer uses.
#   openfootball -> real football fixtures and results, public domain, NO KEY NEEDED
#   api-football -> live api-football.com fixtures/stats (requires SPORTS_API_KEY)
#   demo         -> deterministic simulated data, labelled DEMO DATA throughout
#
# A live provider NEVER silently falls back to demo. If the one named here is
# unconfigured or unknown, the pipeline stops and the interface shows an error,
# because simulated fixtures presented as real sport would be worse than an
# outage. Demo data is reached only by naming it explicitly.
DATA_PROVIDER="openfootball"

# Seasons to import for the openfootball provider, comma separated. Keep this
# short: each season is one file per league, and older seasons add nothing to a
# forecast beyond what the ratings already carry.
OPENFOOTBALL_SEASONS="2024-25,2025-26,2026-27"

# ---------------------------------------------------------------------------
# Optional providers. The default (openfootball) needs no key, so everything
# below can stay empty.
# ---------------------------------------------------------------------------
# https://www.api-football.com/  (RapidAPI or direct dashboard key)
SPORTS_API_KEY=""
SPORTS_API_BASE_URL="https://v3.football.api-sports.io"

# https://the-odds-api.com/
ODDS_API_KEY=""
ODDS_API_BASE_URL="https://api.the-odds-api.com/v4"

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Shared secret required by mutating API routes (POST/PATCH/DELETE) and by the
# admin ingestion endpoints. Generate with: openssl rand -hex 32
# Leave empty in local development to disable the check.
API_ACCESS_KEY=""

# Requests per window, per client, for /api/* routes.
RATE_LIMIT_MAX="120"
RATE_LIMIT_WINDOW_MS="60000"

# ---------------------------------------------------------------------------
# Pipeline scope (read by scripts/data.ts)
# ---------------------------------------------------------------------------
# Days of history to import. ~900 is two seasons, enough for ratings to settle.
HISTORY_DAYS="900"
# Days of upcoming fixtures to import and predict.
FORECAST_DAYS="8"
# How many past matches to backfill predictions for, to measure accuracy.
BACKFILL_LIMIT="400"
